# ---------------------------------------------------------------------------
# Database (REQUIRED for production/Vercel)
# ---------------------------------------------------------------------------
# On Vercel/serverless you MUST use a hosted PostgreSQL (e.g. Supabase).
# SQLite (DATABASE_PATH) will NOT work on Vercel — the file is ephemeral.
#
# Local SQLite (development only):
#   DATABASE_PATH=data/living-tree.sqlite
#
# Production PostgreSQL (Vercel / Supabase):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Public URL (safe to expose to the browser)
# ---------------------------------------------------------------------------
# Leave blank to derive QR/share links from the browser address.
# On Vercel set this to your production domain:
#   NEXT_PUBLIC_APP_URL=https://gm-tree.vercel.app
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# OpenAI / OpenRouter (server-only, never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Set AI_MODE=offline to never send visitor text to any external provider.
AI_MODE=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3.5-lightning
AI_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Staff authentication (server-only, generated by `npm run setup` locally)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
# Generated by setup; keep this stable and backed up with the database.
# It encrypts private visitor messages/replies and must remain server-only.
MESSAGE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Rate limiting (server-only)
# ---------------------------------------------------------------------------
# Each signed visitor cookie gets 5 attempts per 10 minutes.
# Global cap limits provider spend; no IP addresses are stored.
SUBMISSION_RATE_LIMIT=5
GLOBAL_RATE_LIMIT=60
