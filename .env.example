# Local Node host only. Never prefix secrets with NEXT_PUBLIC_.
# SQLite is created automatically; optional absolute path override:
# DATABASE_PATH=E:/Agentic Hackathon/GMC/data/living-tree.sqlite

# Leave blank to derive QR/share links from the browser address.
# For phones, open the app using your laptop LAN IP rather than localhost.
NEXT_PUBLIC_APP_URL=

# auto = OpenAI if a key exists, otherwise curated offline fallback.
# offline = never send visitor text to any external provider.
AI_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_TIMEOUT_MS=15000

# npm run setup generates a random staff password in .env.local.
ADMIN_PASSWORD=
# Generated by setup; keep this stable and backed up with the local database.
# It encrypts private visitor messages and replies and must remain server-only.
MESSAGE_ENCRYPTION_KEY=

# Each signed visitor cookie gets 5 attempts per 10 minutes.
# Global cap limits provider spend; no IP addresses are stored.
SUBMISSION_RATE_LIMIT=5
GLOBAL_RATE_LIMIT=60
